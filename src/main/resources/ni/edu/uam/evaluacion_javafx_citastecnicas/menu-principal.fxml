<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="460.0" prefWidth="640.0" spacing="16.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.MenuPrincipalController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="TecnoAsistencia Nicaragua S.A.">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>

    <Label text="Sistema de gestion de citas de atencion tecnica" textFill="#5a6472" />

    <Button onAction="#abrirClientes" prefHeight="42.0" prefWidth="280.0" text="Clientes">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Button>

    <Button onAction="#abrirCitas" prefHeight="42.0" prefWidth="280.0" text="Citas tecnicas">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Button>

    <Button onAction="#salir" prefHeight="42.0" prefWidth="280.0" text="Salir">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Button>
</VBox>
